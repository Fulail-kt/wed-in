---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import {
  GUEST_NAME_MAX,
  GUEST_NAME_MIN,
  listGuests,
  listUnknownGuests,
  summarizeGuests,
  summarizeUnknown,
} from '../lib/guests';
import { getRedis } from '../lib/redis';
import { envGet } from '../lib/env';

const adminKey = envGet('ADMIN_SECRET_KEY', 'admin');
const providedKey = Astro.url.searchParams.get('key') ?? '';
const isAuthorized = providedKey.length > 0 && providedKey === adminKey;

let guests: Awaited<ReturnType<typeof listGuests>> = [];
let unknownGuests: Awaited<ReturnType<typeof listUnknownGuests>> = [];
let summary = {
  totalAttending: 0,
  declined: 0,
  pending: 0,
  invited: 0,
  unknownGuests: 0,
  unknownAttending: 0,
};
let redisOk = false;

if (isAuthorized) {
  redisOk = getRedis() !== null;
  if (redisOk) {
    // One fetch each — no getFullSummary double-read
    const [guestList, unknownList] = await Promise.all([
      listGuests(),
      listUnknownGuests(),
    ]);
    guests = guestList;
    unknownGuests = unknownList;
    const guestSummary = summarizeGuests(guestList);
    const unknownSummary = summarizeUnknown(unknownList);
    summary = {
      totalAttending: guestSummary.totalAttending + unknownSummary.totalAttending,
      declined: guestSummary.declined + unknownSummary.declined,
      pending: guestSummary.pending,
      invited: guestSummary.totalGuests,
      unknownGuests: unknownList.length,
      unknownAttending: unknownSummary.totalAttending,
    };
  }
}

const siteUrl = Astro.url.origin;

function statusBadge(status: 'yes' | 'no' | 'pending') {
  if (status === 'yes') {
    return 'text-[#4A6B53] bg-[#EBF2EC]';
  }
  if (status === 'no') {
    return 'text-[#9E5A64] bg-[#F7ECED]';
  }
  return 'text-[#8A827B] bg-[#F9F7F2]';
}

function statusLabel(status: 'yes' | 'no' | 'pending') {
  if (status === 'yes') return 'Yes';
  if (status === 'no') return 'No';
  return 'Pending';
}
---

<Layout title="Admin Panel — Wedding Invitation">
  <main class="min-h-screen w-full px-3 sm:px-4 py-8 sm:py-12 md:py-16 bg-[var(--bg-page)]">
    {!isAuthorized && (
      <div class="min-h-[70vh] flex items-center justify-center">
        <div class="surface-card w-full max-w-md px-6 sm:px-8 py-10 text-center">
          <p class="text-[11px] tracking-[0.28em] uppercase text-[#8A827B] font-medium mb-3">
            Restricted
          </p>
          <h1 class="font-serif-title text-3xl text-[#2A2523] mb-3">Admin Access</h1>
          <p class="text-sm text-[#8A827B] mb-6 leading-relaxed">
            Open with your secret key from <code class="text-[#4A6B53]">.env</code>
            (<code class="text-[#4A6B53]">ADMIN_SECRET_KEY</code>):
          </p>
          <code class="block text-xs sm:text-sm text-[#4A6B53] bg-[#EBF2EC] px-4 py-3 rounded-xl break-all">
            /admin?key=YOUR_ADMIN_SECRET_KEY
          </code>
        </div>
      </div>
    )}

    {isAuthorized && (
      <div class="w-full max-w-3xl mx-auto space-y-4 sm:space-y-5">
        <div class="text-center mb-4 sm:mb-6 px-1">
          <p class="text-[11px] tracking-[0.28em] uppercase text-[#8A827B] font-medium mb-2">
            Restricted access
          </p>
          <h1 class="font-serif-title text-3xl sm:text-4xl text-[#2A2523]">Admin Dashboard</h1>
          <p class="font-serif-body text-base sm:text-lg italic text-[#8A827B] mt-2">
            Guest list &amp; RSVP counts
          </p>
        </div>

        {!redisOk && (
          <div class="rounded-2xl border border-[#9E5A64]/30 bg-[#F7ECED] px-4 py-3 text-sm text-[#9E5A64] text-center">
            Redis not connected — add Upstash env vars in <code>.env</code>
          </div>
        )}

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
          <div class="surface-card px-3 sm:px-4 py-4 sm:py-5 text-center">
            <div class="font-serif-title text-2xl sm:text-3xl text-[#4A6B53]">{summary.totalAttending}</div>
            <p class="text-[10px] tracking-[0.18em] uppercase text-[#8A827B] mt-1">Attending</p>
          </div>
          <div class="surface-card px-3 sm:px-4 py-4 sm:py-5 text-center">
            <div class="font-serif-title text-2xl sm:text-3xl text-[#9E5A64]">{summary.declined}</div>
            <p class="text-[10px] tracking-[0.18em] uppercase text-[#8A827B] mt-1">Declined</p>
          </div>
          <div class="surface-card px-3 sm:px-4 py-4 sm:py-5 text-center">
            <div class="font-serif-title text-2xl sm:text-3xl text-[#8A827B]">{summary.pending}</div>
            <p class="text-[10px] tracking-[0.18em] uppercase text-[#8A827B] mt-1">Pending</p>
          </div>
          <div class="surface-card px-3 sm:px-4 py-4 sm:py-5 text-center">
            <div class="font-serif-title text-2xl sm:text-3xl text-[#2A2523]">{summary.invited}</div>
            <p class="text-[10px] tracking-[0.18em] uppercase text-[#8A827B] mt-1">Invited</p>
          </div>
        </div>

        {summary.unknownGuests > 0 && (
          <div class="surface-card px-4 py-3 text-center text-sm text-[#8A827B]">
            + {summary.unknownGuests} unknown visitor{summary.unknownGuests === 1 ? '' : 's'}
            ({summary.unknownAttending} attending)
          </div>
        )}

        <div class="surface-card px-4 py-6 sm:px-8 sm:py-7">
          <h2 class="font-serif-title text-xl text-[#2A2523] mb-2">Add guest</h2>
          <p class="text-xs text-[#8A827B] mb-4 leading-relaxed">
            Creates guest in DB → link uses ID only (<code>/?g=abc123</code>)
          </p>

          <form id="create-guest-form" class="flex flex-col gap-2" novalidate>
            <div class="flex flex-col sm:flex-row gap-3">
              <div class="w-full flex-1">
                <input
                  id="guest-name-input"
                  name="guestName"
                  type="text"
                  placeholder="e.g. Uncle Sam"
                  autocomplete="name"
                  maxlength={GUEST_NAME_MAX}
                  minlength={GUEST_NAME_MIN}
                  required
                  aria-describedby="guest-name-hint guest-name-error"
                  aria-invalid="false"
                  class="w-full border border-[#E8E2D8] bg-white rounded-xl px-4 py-3.5 text-sm text-[#2A2523] placeholder:text-[#8A827B]/60 outline-none focus:border-[#4A6B53] transition-colors"
                />
              </div>
              <button
                id="create-guest-btn"
                type="submit"
                class="w-full sm:w-auto bg-[#4A6B53] hover:bg-[#3D5A44] disabled:opacity-45 disabled:cursor-not-allowed text-white text-xs tracking-[0.14em] uppercase font-semibold px-5 py-3.5 rounded-xl transition-colors shrink-0"
              >
                Create &amp; Copy Link
              </button>
            </div>
            <p id="guest-name-hint" class="text-[11px] text-[#8A827B] px-0.5">
              {GUEST_NAME_MIN}–{GUEST_NAME_MAX} chars · letters, spaces, hyphens, apostrophes
            </p>
            <p id="guest-name-error" class="text-xs text-[#9E5A64] hidden px-0.5" role="alert"></p>
            <p id="create-msg" class="text-xs hidden text-center"></p>
          </form>
        </div>

        <!-- Guest list: cards on mobile, table on desktop -->
        <div class="surface-card px-3 py-5 sm:px-6">
          <h2 class="font-serif-title text-xl text-[#2A2523] mb-4 px-1 sm:px-2">Guest list</h2>

          {guests.length === 0 ? (
            <p class="text-sm text-[#8A827B] text-center py-8">No guests yet — add one above.</p>
          ) : (
            <>
              <!-- Mobile cards -->
              <div class="flex flex-col gap-3 sm:hidden">
                {guests.map((g) => (
                  <div
                    class="rounded-2xl border border-[#E8E2D8] bg-white/70 px-4 py-4"
                    data-guest-id={g.id}
                  >
                    <div class="flex items-start justify-between gap-3 mb-3">
                      <div class="min-w-0">
                        <p class="text-base font-medium text-[#2A2523] truncate">{g.name}</p>
                        <p class="text-[11px] text-[#8A827B] mt-1">
                          {g.status === 'yes' ? `${g.count} guest${g.count === 1 ? '' : 's'}` : 'No count'}
                        </p>
                      </div>
                      <span class={`shrink-0 text-[10px] tracking-wider uppercase font-semibold px-2.5 py-1 rounded-lg ${statusBadge(g.status)}`}>
                        {statusLabel(g.status)}
                      </span>
                    </div>
                    <div class="flex items-center justify-end gap-2">
                      <button
                        type="button"
                        class="copy-link-btn admin-icon-btn admin-icon-btn--green"
                        data-link={`${siteUrl}/?g=${g.id}`}
                        aria-label={`Copy link for ${g.name}`}
                        title="Copy link"
                      >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                          <rect x="9" y="9" width="13" height="13" rx="2" />
                          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="delete-guest-btn admin-icon-btn admin-icon-btn--rose"
                        data-guest-id={g.id}
                        data-guest-name={g.name}
                        aria-label={`Delete ${g.name}`}
                        title="Delete guest"
                      >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                          <path d="M3 6h18" />
                          <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                          <path d="M10 11v6M14 11v6" />
                        </svg>
                      </button>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Desktop table -->
              <div class="hidden sm:block overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="text-[10px] tracking-[0.15em] uppercase text-[#8A827B] border-b border-[#E8E2D8]">
                      <th class="text-left py-3 px-2 font-medium">Name</th>
                      <th class="text-left py-3 px-2 font-medium">Status</th>
                      <th class="text-center py-3 px-2 font-medium">Count</th>
                      <th class="text-right py-3 px-2 font-medium">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {guests.map((g) => (
                      <tr class="border-b border-[#E8E2D8]/60 last:border-0" data-guest-id={g.id}>
                        <td class="py-3.5 px-2 text-[#2A2523] font-medium">{g.name}</td>
                        <td class="py-3.5 px-2">
                          <span class={`text-[10px] tracking-wider uppercase font-semibold px-2.5 py-1 rounded-lg ${statusBadge(g.status)}`}>
                            {statusLabel(g.status)}
                          </span>
                        </td>
                        <td class="py-3.5 px-2 text-center font-serif-title text-lg text-[#2A2523]">
                          {g.status === 'yes' ? g.count : '—'}
                        </td>
                        <td class="py-3.5 px-2">
                          <div class="flex items-center justify-end gap-2">
                            <button
                              type="button"
                              class="copy-link-btn admin-icon-btn admin-icon-btn--green"
                              data-link={`${siteUrl}/?g=${g.id}`}
                              aria-label={`Copy link for ${g.name}`}
                              title="Copy link"
                            >
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <rect x="9" y="9" width="13" height="13" rx="2" />
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                              </svg>
                            </button>
                            <button
                              type="button"
                              class="delete-guest-btn admin-icon-btn admin-icon-btn--rose"
                              data-guest-id={g.id}
                              data-guest-name={g.name}
                              aria-label={`Delete ${g.name}`}
                              title="Delete guest"
                            >
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path d="M3 6h18" />
                                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                <path d="M10 11v6M14 11v6" />
                              </svg>
                            </button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          )}
        </div>

        <!-- Unknown visitors -->
        <div class="surface-card px-3 py-5 sm:px-6">
          <h2 class="font-serif-title text-xl text-[#2A2523] mb-1 px-1 sm:px-2">Unknown visitors</h2>
          <p class="text-xs text-[#8A827B] mb-4 px-1 sm:px-2">No personal link — tracked by browser ID</p>

          {unknownGuests.length === 0 ? (
            <p class="text-sm text-[#8A827B] text-center py-6">None yet.</p>
          ) : (
            <>
              <div class="flex flex-col gap-3 sm:hidden">
                {unknownGuests.map((u) => (
                  <div class="rounded-2xl border border-[#E8E2D8] bg-white/70 px-4 py-4">
                    <div class="flex items-start justify-between gap-3 mb-3">
                      <div class="min-w-0">
                        <p class="font-mono text-xs text-[#8A827B] truncate">{u.id}</p>
                        <p class="text-[11px] text-[#8A827B] mt-1">
                          {u.updatedAt ? new Date(u.updatedAt).toLocaleDateString() : '—'}
                          {u.status === 'yes' ? ` · ${u.count} guest${u.count === 1 ? '' : 's'}` : ''}
                        </p>
                      </div>
                      <span class={`shrink-0 text-[10px] tracking-wider uppercase font-semibold px-2.5 py-1 rounded-lg ${statusBadge(u.status)}`}>
                        {statusLabel(u.status)}
                      </span>
                    </div>
                    <div class="flex items-center justify-end">
                      <button
                        type="button"
                        class="delete-unknown-btn admin-icon-btn admin-icon-btn--rose"
                        data-anonymous-id={u.id}
                        aria-label={`Delete unknown ${u.id}`}
                        title="Delete RSVP"
                      >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                          <path d="M3 6h18" />
                          <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                          <path d="M10 11v6M14 11v6" />
                        </svg>
                      </button>
                    </div>
                  </div>
                ))}
              </div>

              <div class="hidden sm:block overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="text-[10px] tracking-[0.15em] uppercase text-[#8A827B] border-b border-[#E8E2D8]">
                      <th class="text-left py-3 px-2 font-medium">ID</th>
                      <th class="text-left py-3 px-2 font-medium">Status</th>
                      <th class="text-center py-3 px-2 font-medium">Count</th>
                      <th class="text-right py-3 px-2 font-medium">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {unknownGuests.map((u) => (
                      <tr class="border-b border-[#E8E2D8]/60 last:border-0">
                        <td class="py-3.5 px-2 text-[#8A827B] font-mono text-xs">{u.id}</td>
                        <td class="py-3.5 px-2">
                          <span class={`text-[10px] tracking-wider uppercase font-semibold px-2.5 py-1 rounded-lg ${statusBadge(u.status)}`}>
                            {statusLabel(u.status)}
                          </span>
                        </td>
                        <td class="py-3.5 px-2 text-center font-serif-title text-lg text-[#2A2523]">
                          {u.status === 'yes' ? u.count : '—'}
                        </td>
                        <td class="py-3.5 px-2">
                          <div class="flex items-center justify-end gap-3">
                            <span class="text-[10px] text-[#8A827B]">
                              {u.updatedAt ? new Date(u.updatedAt).toLocaleDateString() : '—'}
                            </span>
                            <button
                              type="button"
                              class="delete-unknown-btn admin-icon-btn admin-icon-btn--rose"
                              data-anonymous-id={u.id}
                              aria-label={`Delete unknown ${u.id}`}
                              title="Delete RSVP"
                            >
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path d="M3 6h18" />
                                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                <path d="M10 11v6M14 11v6" />
                              </svg>
                            </button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          )}
        </div>
      </div>
    )}
  </main>

  <!-- Custom confirm modal -->
  <div
    id="admin-modal"
    class="fixed inset-0 z-[80] hidden items-end sm:items-center justify-center p-0 sm:p-4"
    aria-hidden="true"
  >
    <button
      type="button"
      id="admin-modal-backdrop"
      class="absolute inset-0 bg-[#2A2523]/40 backdrop-blur-[2px]"
      aria-label="Close dialog"
    ></button>
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="admin-modal-title"
      class="relative z-10 w-full sm:max-w-sm bg-[var(--bg-card)] border border-[#E8E2D8] rounded-t-3xl sm:rounded-3xl shadow-[0_20px_60px_rgba(42,37,35,0.18)] px-6 pt-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] sm:p-7"
    >
      <div class="w-10 h-10 rounded-2xl bg-[#F7ECED] text-[#9E5A64] flex items-center justify-center mb-4 mx-auto sm:mx-0">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18" />
          <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
          <path d="M10 11v6M14 11v6" />
        </svg>
      </div>
      <h3 id="admin-modal-title" class="font-serif-title text-2xl text-[#2A2523] text-center sm:text-left mb-2">
        Delete?
      </h3>
      <p id="admin-modal-body" class="text-sm text-[#8A827B] leading-relaxed text-center sm:text-left mb-6">
        This cannot be undone.
      </p>
      <div class="flex flex-col-reverse sm:flex-row gap-2.5 sm:justify-end">
        <button
          type="button"
          id="admin-modal-cancel"
          class="w-full sm:w-auto px-5 py-3 rounded-xl border border-[#E8E2D8] text-sm font-medium text-[#5A534E] hover:bg-[#F9F7F2] transition-colors"
        >
          Cancel
        </button>
        <button
          type="button"
          id="admin-modal-confirm"
          class="w-full sm:w-auto px-5 py-3 rounded-xl bg-[#9E5A64] hover:bg-[#8A4D56] text-white text-sm font-medium transition-colors"
        >
          Delete
        </button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div
    id="admin-toast"
    class="fixed left-1/2 -translate-x-1/2 bottom-[max(1.25rem,env(safe-area-inset-bottom))] z-[90] hidden px-4 py-2.5 rounded-full text-xs tracking-wide font-medium shadow-[0_10px_30px_rgba(42,37,35,0.14)] pointer-events-none"
    role="status"
  ></div>
</Layout>

<style>
  .admin-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.85rem;
    border: 1px solid #e8e2d8;
    background: #fffefb;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    cursor: pointer;
  }

  .admin-icon-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .admin-icon-btn--green {
    color: #4a6b53;
  }

  .admin-icon-btn--green:hover:not(:disabled) {
    background: #ebf2ec;
    border-color: color-mix(in srgb, #4a6b53 30%, #e8e2d8);
  }

  .admin-icon-btn--rose {
    color: #9e5a64;
  }

  .admin-icon-btn--rose:hover:not(:disabled) {
    background: #f7eced;
    border-color: color-mix(in srgb, #9e5a64 30%, #e8e2d8);
  }
</style>

<script define:vars={{ siteUrl, adminKey: providedKey, nameMin: GUEST_NAME_MIN, nameMax: GUEST_NAME_MAX }}>
  const form = document.getElementById('create-guest-form');
  const createBtn = document.getElementById('create-guest-btn');
  const input = document.getElementById('guest-name-input');
  const createMsg = document.getElementById('create-msg');
  const nameError = document.getElementById('guest-name-error');
  const modal = document.getElementById('admin-modal');
  const modalTitle = document.getElementById('admin-modal-title');
  const modalBody = document.getElementById('admin-modal-body');
  const modalCancel = document.getElementById('admin-modal-cancel');
  const modalConfirm = document.getElementById('admin-modal-confirm');
  const modalBackdrop = document.getElementById('admin-modal-backdrop');
  const toast = document.getElementById('admin-toast');

  let pendingDelete = null;
  let toastTimer = 0;
  const NAME_PATTERN = /^[\p{L}][\p{L}\p{M}\s.'’\-]*$/u;

  function validateName(raw) {
    const collapsed = String(raw || '').trim().replace(/\s+/g, ' ');
    if (!collapsed) return { ok: false, error: 'Name required' };
    if (collapsed.length < nameMin) {
      return { ok: false, error: `Name must be at least ${nameMin} characters` };
    }
    if (collapsed.length > nameMax) {
      return { ok: false, error: `Name must be ${nameMax} characters or less` };
    }
    if (!NAME_PATTERN.test(collapsed)) {
      return { ok: false, error: 'Use letters only (spaces, hyphens, apostrophes OK)' };
    }
    if (!/[\p{L}]{2,}/u.test(collapsed.replace(/[^\p{L}]/gu, ''))) {
      return { ok: false, error: 'Name needs at least 2 letters' };
    }
    return { ok: true, name: collapsed };
  }

  function setNameError(message) {
    if (!input || !nameError) return;
    if (message) {
      nameError.textContent = message;
      nameError.classList.remove('hidden');
      input.setAttribute('aria-invalid', 'true');
      input.classList.add('border-[#9E5A64]', 'bg-[#FDF8F9]');
      input.classList.remove('border-[#E8E2D8]');
    } else {
      nameError.textContent = '';
      nameError.classList.add('hidden');
      input.setAttribute('aria-invalid', 'false');
      input.classList.remove('border-[#9E5A64]', 'bg-[#FDF8F9]');
      input.classList.add('border-[#E8E2D8]');
    }
  }

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }
  }

  function showMsg(text, ok = true) {
    if (!createMsg) return;
    createMsg.textContent = text;
    createMsg.className = `text-xs text-center ${ok ? 'text-[#4A6B53]' : 'text-[#9E5A64]'}`;
    createMsg.classList.remove('hidden');
    setTimeout(() => createMsg.classList.add('hidden'), 4000);
  }

  function showToast(text, ok = true) {
    if (!toast) return;
    toast.textContent = text;
    toast.className = `fixed left-1/2 -translate-x-1/2 bottom-[max(1.25rem,env(safe-area-inset-bottom))] z-[90] px-4 py-2.5 rounded-full text-xs tracking-wide font-medium shadow-[0_10px_30px_rgba(42,37,35,0.14)] pointer-events-none ${
      ok ? 'bg-[#4A6B53] text-white' : 'bg-[#9E5A64] text-white'
    }`;
    toast.classList.remove('hidden');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.add('hidden'), 2600);
  }

  function openModal({ title, body, onConfirm }) {
    if (!modal || !modalTitle || !modalBody) return;
    pendingDelete = onConfirm;
    modalTitle.textContent = title;
    modalBody.textContent = body;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    modalConfirm?.focus();
  }

  function closeModal() {
    if (!modal) return;
    pendingDelete = null;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (modalConfirm) {
      modalConfirm.disabled = false;
      modalConfirm.textContent = 'Delete';
    }
  }

  modalCancel?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  modalConfirm?.addEventListener('click', async () => {
    if (!pendingDelete || !modalConfirm) return;
    modalConfirm.disabled = true;
    modalConfirm.textContent = 'Deleting…';
    try {
      await pendingDelete();
      closeModal();
      showToast('Deleted');
      location.reload();
    } catch {
      modalConfirm.disabled = false;
      modalConfirm.textContent = 'Delete';
      showToast('Delete failed', false);
    }
  });

  input?.addEventListener('input', () => {
    if (nameError && !nameError.classList.contains('hidden')) {
      const result = validateName(input.value);
      setNameError(result.ok ? '' : result.error);
    }
  });

  input?.addEventListener('blur', () => {
    if (!input.value.trim()) {
      setNameError('');
      return;
    }
    const result = validateName(input.value);
    setNameError(result.ok ? '' : result.error);
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const result = validateName(input?.value);
    if (!result.ok) {
      setNameError(result.error);
      input?.focus();
      return;
    }

    setNameError('');
    createBtn.disabled = true;
    createBtn.textContent = 'Creating…';

    try {
      const res = await fetch('/api/guests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: result.name, key: adminKey }),
      });
      const data = await res.json();
      if (!res.ok) {
        setNameError(data.error || 'Failed');
        showMsg(data.error || 'Failed', false);
        return;
      }

      const link = `${siteUrl}/?g=${data.guest.id}`;
      await copyText(link);
      showToast('Guest created · link copied');
      if (input) input.value = '';
      location.reload();
    } catch {
      showMsg('Network error', false);
    } finally {
      createBtn.disabled = false;
      createBtn.textContent = 'Create & Copy Link';
    }
  });

  document.querySelectorAll('.copy-link-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const link = btn.getAttribute('data-link');
      if (!link) return;
      await copyText(link);
      showToast('Link copied');
      btn.classList.add('ring-2', 'ring-[#4A6B53]/30');
      setTimeout(() => btn.classList.remove('ring-2', 'ring-[#4A6B53]/30'), 900);
    });
  });

  async function deleteRecord(body) {
    const res = await fetch('/api/guests', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...body, key: adminKey }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Delete failed');
  }

  document.querySelectorAll('.delete-guest-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-guest-id');
      const name = btn.getAttribute('data-guest-name') || 'this guest';
      if (!id) return;
      openModal({
        title: `Delete ${name}?`,
        body: 'Their invite link will stop working. This cannot be undone.',
        onConfirm: () => deleteRecord({ guestId: id }),
      });
    });
  });

  document.querySelectorAll('.delete-unknown-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-anonymous-id');
      if (!id) return;
      openModal({
        title: 'Delete this RSVP?',
        body: 'Unknown visitor response will be removed from the database.',
        onConfirm: () => deleteRecord({ anonymousId: id }),
      });
    });
  });
</script>
