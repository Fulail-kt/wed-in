---
import Layout from '../layouts/Layout.astro';
import HeroBanner from '../components/HeroBanner';
import AudioPlayer from '../components/AudioPlayer';
import InvitationGate from '../components/InvitationGate';
import CountdownTimer from '../components/CountdownTimer';
import EventDetails from '../components/EventDetails';
import RsvpSection from '../components/RsvpSection';
import Footer from '../components/Footer';
import FallingPetals from '../components/FallingPetals';
import PageAmbience from '../components/PageAmbience';
import { getGuest, formatGuestName } from '../lib/guests';

const guestIdParam = Astro.url.searchParams.get('g') ?? undefined;
let guestId: string | undefined;
let guestName: string | undefined;
let guestStatus: 'pending' | 'yes' | 'no' | undefined;
let guestCount = 0;

if (guestIdParam) {
  const guest = await getGuest(guestIdParam);
  if (guest) {
    guestId = guestIdParam;
    guestName = guest.name;
    guestStatus = guest.status;
    guestCount = guest.count;
  }
}

if (!guestName) {
  guestName = Astro.url.searchParams.get('guest') ?? undefined;
}

if (guestName) {
  guestName = formatGuestName(guestName);
}
---

<Layout guestName={guestName}>
  <InvitationGate client:load guestName={guestName} />
  <FallingPetals client:load />
  <PageAmbience client:load />
  <AudioPlayer client:load />

  <main class="w-full min-h-screen flex flex-col items-center overflow-x-hidden pt-8 sm:pt-14 px-4 sm:px-5 pb-[env(safe-area-inset-bottom)]">
    <HeroBanner client:load guestName={guestName} />
    <CountdownTimer client:load />
    <EventDetails client:load />
    <RsvpSection
      client:load
      guestId={guestId}
      guestName={guestName}
      initialStatus={guestStatus}
      initialCount={guestCount}
    />
    <Footer client:load />
  </main>
</Layout>
